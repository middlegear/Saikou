            <!-- 6. Updater Row -->
            <RelativeLayout
                android:id="@+id/settingsUpdaterRow"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="12dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconSystemUpdater"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/baseline_system_update_24"
                    app:tint="?attr/colorPrimary"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"
                    android:layout_toEndOf="@id/iconSystemUpdater"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Updater"
                    android:textColor="@color/bg_opp"
                    android:textSize="16sp"
                    tools:ignore="HardcodedText" />

                <androidx.cardview.widget.CardView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_alignParentEnd="true"
                    android:duplicateParentState="true"
                    app:cardBackgroundColor="@color/nav_bg_inv"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <ImageButton
                        android:id="@+id/btnUpdaterChevron"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@color/nav_bg_inv"
                        android:duplicateParentState="true"
                        android:padding="16dp"
                        app:srcCompat="@drawable/round_chevron_right_24"
                        app:tint="@color/bg_opp"
                        tools:ignore="ContentDescription,SpeakableTextPresentCheck" />
                </androidx.cardview.widget.CardView>
            </RelativeLayout>
            <!-- 7. About Row -->
            <RelativeLayout
                android:id="@+id/settingsAboutRow"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="32dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconAbout"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_round_info_24"
                    app:tint="?attr/colorPrimary"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"
                    android:layout_toEndOf="@id/iconAbout"
                    android:fontFamily="@font/poppins_bold"
                    android:text="About"
                    android:textColor="@color/bg_opp"
                    android:textSize="16sp"
                    tools:ignore="HardcodedText" />

                <androidx.cardview.widget.CardView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_alignParentEnd="true"
                    android:duplicateParentState="true"
                    app:cardBackgroundColor="@color/nav_bg_inv"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <ImageButton
                        android:id="@+id/btnAboutChevron"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@color/nav_bg_inv"
                        android:duplicateParentState="true"
                        android:padding="16dp"
                        app:srcCompat="@drawable/round_chevron_right_24"
                        app:tint="@color/bg_opp"
                        tools:ignore="ContentDescription,SpeakableTextPresentCheck" />
                </androidx.cardview.widget.CardView>
            </RelativeLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>